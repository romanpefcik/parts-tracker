generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Part {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  category    String?
  value       String?
  package     String?
  supplier    String?
  datasheet   String?
  quantity    Int     @default(0)
  notes       String?

  allocations Allocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  status      String   @default("active")

  allocations Allocation[]
  boxes       ProjectBox[]
  schematic   Schematic?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectBox {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  order       Int     @default(0)

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId Int

  schematic Schematic?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Schematic {
  id   Int    @id @default(autoincrement())
  name String
  data String @default("{\"nodes\":[],\"edges\":[]}")

  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId Int?     @unique

  box   ProjectBox? @relation(fields: [boxId], references: [id], onDelete: Cascade)
  boxId Int?        @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Allocation {
  id        Int     @id @default(autoincrement())
  quantity  Int
  notes     String?

  part      Part    @relation(fields: [partId], references: [id])
  partId    Int
  project   Project @relation(fields: [projectId], references: [id])
  projectId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([partId, projectId])
}
